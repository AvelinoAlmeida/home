% =============================================================================
%  cvestilo.sty: estilo partilhado pelo CV e pela carta de apresentação.
%  Mudar aqui a cor, a fonte ou o formato das secções muda os dois documentos.
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo/cvestilo}[2026/10/15 Estilo CV Avelino Almeida]

% --- Fontes (Roboto: o hífen é extraído corretamente; Source Sans 3 partia "T-SQL")
\RequirePackage{fontspec}
\setmainfont{Roboto}[UprightFont=*-Light,BoldFont=*-Medium,ItalicFont=*-LightItalic,BoldItalicFont=*-MediumItalic]
\newfontfamily\robotobold{Roboto}[UprightFont=*-Bold]
\newfontfamily\robotothin{Roboto}[UprightFont=*-Thin]

% --- Cores
\RequirePackage{xcolor}
\definecolor{acento}{HTML}{0395DE}
\definecolor{texto}{HTML}{333333}
\definecolor{cinza}{HTML}{5D5D5D}
\definecolor{cinzaclaro}{HTML}{999999}
\definecolor{preencher}{HTML}{D0021B}

% --- Pacotes
\RequirePackage{xstring}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\RequirePackage[hidelinks]{hyperref}

% --- Parágrafos: sem hifenização (evita cortes errados e palavras-chave partidas)
\hyphenpenalty=10000 \exhyphenpenalty=10000
\setlength{\parindent}{0pt}
\raggedbottom
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}

% --- Cabeçalho: nome, título e contactos (dados em dados/pessoais.tex)
\newcommand{\cabecalho}{%
  \begin{center}
    {\fontsize{30}{34}\selectfont{\robotothin\CVnome} {\robotobold\CVapelido}}\\[4pt]
    {\small\scshape\color{acento}\CVtitulo}\\[3pt]
    {\footnotesize\color{cinza}
     \CVlocal{} \textbar{}
     \href{mailto:\CVemail}{\CVemail} \textbar{}
     \CVtelefone{} \textbar{}
     \href{https://www.\CVlinkedin}{\CVlinkedin} \textbar{}
     \href{https://\CVsite/}{\CVsite}}
  \end{center}}

% --- Título de secção: 3 primeiras letras na cor de destaque + linha
\newcommand{\secao}[1]{%
  \needspace{10\baselineskip}\vspace{6pt}%
  {\fontsize{13.5}{16}\selectfont\robotobold
   \StrLeft{#1}{3}[\ini]\StrGobbleLeft{#1}{3}[\rest]%
   {\color{acento}\ini}\rest}%
  \hspace{6pt}{\color{cinzaclaro}\leaders\hrule height 0.6pt depth -0.1pt\hfill}%
  \par\vspace{3pt}}

% --- Entrada: {cargo}{entidade}{local}{datas}
\newcommand{\entrada}[4]{%
  \needspace{4\baselineskip}%
  {\robotobold\color{texto}#1}\hfill{\itshape\color{acento}#4}\\
  {\small\scshape\color{cinza}#2}\hfill{\small\itshape\color{cinzaclaro}#3}\par\vspace{1pt}}

% --- Competência: rótulo e valores na mesma linha (o ATS mantém a ligação)
\newcommand{\competencia}[2]{%
  {\raggedright\hangindent=3.8cm\hangafter=1
   \makebox[3.6cm][r]{\robotobold\color{texto}#1}\hspace{0.2cm}{\color{cinza}#2}\par}\vspace{1.5pt}}

% --- Linha simples (certificações, idiomas)
\newcommand{\linha}[2]{%
  {\raggedright\hangindent=1em\hangafter=1{\robotobold\color{texto}#1}\ {\color{cinza}#2}\par}\vspace{2pt}}

% --- Lista de pontos
\setlist[itemize]{leftmargin=1.1em,itemsep=1pt,topsep=2pt,label={\color{acento}\textbullet}}
\newenvironment{itens}{\begin{itemize}\small\color{cinza}\raggedright}{\end{itemize}\vspace{4pt}}

% --- Carta: campo por preencher (a vermelho) e data em português
\newcommand{\pf}[1]{{\color{preencher}[#1]}}
\newcommand{\datapt}{\number\day{} de \ifcase\month\or janeiro\or fevereiro\or março\or abril\or maio\or junho\or julho\or agosto\or setembro\or outubro\or novembro\or dezembro\fi{} de \number\year}

\endinput
